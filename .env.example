# nook-business environment variables.
# Copy to .env.local for local dev; set the same keys in Vercel for production.

# ── Supabase (required — the app will not boot without these) ─────────────
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Service-role key. Backs every privileged owner write (photo/menu uploads,
# menu categories, analytics upsert). Owner editing silently fails without it.
# NEVER expose this to the browser (no NEXT_PUBLIC_ prefix).
SUPABASE_SERVICE_ROLE_KEY=

# Public base URL of this app. Used to build auth email links (signup
# confirmation). Falls back to the request origin, but set it explicitly in
# production or confirmation links can point at the wrong host.
NEXT_PUBLIC_SITE_URL=https://business.example.com

# ── DigitalOcean Spaces (photo + menu image uploads) ──────────────────────
# Without these, all image uploads fail (they now fail loudly, not silently).
DO_SPACES_ENDPOINT=https://sgp1.digitaloceanspaces.com
DO_SPACES_KEY=
DO_SPACES_SECRET=
DO_SPACES_BUCKET=
# Public CDN base used to build image URLs. Must match the hostname allowed in
# next.config.ts remotePatterns.
DO_SPACES_CDN_URL=https://<bucket>.sgp1.cdn.digitaloceanspaces.com

# ── Resend (owner address-correction email) ───────────────────────────────
# Without these the correction form tells the owner it isn't configured
# instead of silently dropping the request.
RESEND_API_KEY=
CORRECTION_REQUEST_TO=team@example.com
# Optional — must be a verified Resend sender. Defaults to noreply@nookph.app.
CORRECTION_REQUEST_FROM=Nook <noreply@nookph.app>

# ── New-cafe-claim alert (internal) ───────────────────────────────────────
# Emailed whenever an owner submits a new claim. Both are optional and fall
# back to in-code defaults; the alert is best-effort and never blocks a claim.
CLAIM_NOTIFICATION_TO=team@example.com
CLAIM_NOTIFICATION_FROM=Nook <noreply@nookph.app>
# Optional — when set, the alert includes a link to the admin claim queue.
ADMIN_SITE_URL=https://admin.example.com

# ── PostHog + cron (owner dashboard analytics) ────────────────────────────
# Without these the daily analytics sync fails and owner metrics stay at zero.
POSTHOG_PROJECT_ID=
POSTHOG_PERSONAL_API_KEY=
# Bearer secret guarding /api/analytics-sync. The route rejects all requests
# when this is unset, so it must be set for the Vercel cron to work.
CRON_SECRET=
